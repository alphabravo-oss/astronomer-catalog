{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astronomer.alphabravo.io/schemas/catalog-entry-v1.json",
  "title": "Astronomer catalog entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "summary", "category", "supportTier", "artifact", "compatibility", "resources", "storage", "lifecycle"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "enum": ["monitoring", "logging", "security", "networking", "storage", "database", "other"] },
    "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "home": { "type": "string", "format": "uri" },
    "documentation": { "type": "string", "format": "uri" },
    "icon": { "type": "string", "format": "uri" },
    "supportTier": { "enum": ["astronomer", "upstream", "experimental"] },
    "defaultEnabled": { "type": "boolean" },
    "privileged": { "type": "boolean" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "chart", "version"],
      "properties": {
        "type": { "const": "helm" },
        "repository": { "type": "string", "minLength": 1 },
        "chart": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["kubernetes"],
      "properties": { "kubernetes": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "required": ["profile"],
      "properties": { "profile": { "enum": ["small", "medium", "large", "variable"] } },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "required": ["required"],
      "properties": { "required": { "type": "boolean" } },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "upgrade", "rollback", "uninstall"],
      "properties": {
        "install": { "type": "boolean" },
        "upgrade": { "type": "boolean" },
        "rollback": { "type": "boolean" },
        "uninstall": { "type": "boolean" }
      }
    }
  }
}

