{
  "$schema": "./schemas/catalog-index-v1.schema.json",
  "apiVersion": "catalog.astronomer.dev/v1alpha1",
  "kind": "ApplicationCatalog",
  "metadata": {
    "name": "astronomer",
    "displayName": "Astronomer Catalog",
    "description": "Upstream applications curated for deployment through Astronomer and Flux.",
    "channel": "development"
  },
  "repositories": [
    { "name": "prometheus-community", "type": "helm", "url": "https://prometheus-community.github.io/helm-charts" },
    { "name": "metrics-server", "type": "helm", "url": "https://kubernetes-sigs.github.io/metrics-server/" },
    { "name": "grafana", "type": "helm", "url": "https://grafana.github.io/helm-charts" },
    { "name": "aqua", "type": "helm", "url": "https://aquasecurity.github.io/helm-charts/" },
    { "name": "jetstack", "type": "helm", "url": "https://charts.jetstack.io" },
    { "name": "ingress-nginx", "type": "helm", "url": "https://kubernetes.github.io/ingress-nginx" }
  ],
  "applications": [
    {
      "slug": "kube-state-metrics",
      "name": "Kube State Metrics",
      "summary": "Cluster object-state metrics for Astronomer dashboards and Prometheus.",
      "category": "monitoring",
      "keywords": ["kubernetes", "metrics", "inventory"],
      "home": "https://github.com/kubernetes/kube-state-metrics",
      "documentation": "https://github.com/kubernetes/kube-state-metrics/tree/main/docs",
      "supportTier": "astronomer",
      "defaultEnabled": true,
      "privileged": false,
      "artifact": { "type": "helm", "repository": "prometheus-community", "chart": "kube-state-metrics", "version": "8.4.0" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "small" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "prometheus-node-exporter",
      "name": "Prometheus Node Exporter",
      "summary": "Host metrics for node and capacity dashboards.",
      "category": "monitoring",
      "keywords": ["nodes", "metrics", "capacity"],
      "home": "https://github.com/prometheus/node_exporter",
      "documentation": "https://github.com/prometheus-community/helm-charts/tree/main/charts/prometheus-node-exporter",
      "supportTier": "astronomer",
      "defaultEnabled": true,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "prometheus-community", "chart": "prometheus-node-exporter", "version": "4.56.1" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "small" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "metrics-server",
      "name": "Metrics Server",
      "summary": "Kubernetes resource metrics API for autoscaling and live usage.",
      "category": "monitoring",
      "keywords": ["autoscaling", "cpu", "memory"],
      "home": "https://github.com/kubernetes-sigs/metrics-server",
      "documentation": "https://github.com/kubernetes-sigs/metrics-server/tree/master/charts/metrics-server",
      "supportTier": "upstream",
      "defaultEnabled": false,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "metrics-server", "chart": "metrics-server", "version": "3.14.0" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "small" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "kube-prometheus-stack",
      "name": "Kube Prometheus Stack",
      "summary": "Prometheus Operator, Prometheus, Alertmanager, Grafana, dashboards, and rules.",
      "category": "monitoring",
      "keywords": ["prometheus", "grafana", "alertmanager"],
      "home": "https://github.com/prometheus-operator/kube-prometheus",
      "documentation": "https://github.com/prometheus-community/helm-charts/tree/main/charts/kube-prometheus-stack",
      "supportTier": "experimental",
      "defaultEnabled": false,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "prometheus-community", "chart": "kube-prometheus-stack", "version": "88.5.4" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "large" },
      "storage": { "required": true, "recommended": "100Gi" },
      "lifecycle": { "install": true, "upgrade": true, "rollback": false, "uninstall": true }
    },
    {
      "slug": "grafana",
      "name": "Grafana",
      "summary": "Dashboards and visualization for metrics, logs, and traces.",
      "category": "monitoring",
      "keywords": ["dashboards", "visualization"],
      "home": "https://grafana.com/oss/grafana/",
      "documentation": "https://github.com/grafana/helm-charts/tree/main/charts/grafana",
      "supportTier": "upstream",
      "defaultEnabled": false,
      "privileged": false,
      "artifact": { "type": "helm", "repository": "grafana", "chart": "grafana", "version": "10.5.15" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "medium" },
      "storage": { "required": true, "recommended": "10Gi" },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "loki",
      "name": "Loki",
      "summary": "Horizontally scalable log aggregation from Grafana Labs.",
      "category": "logging",
      "keywords": ["logs", "observability"],
      "home": "https://grafana.com/oss/loki/",
      "documentation": "https://grafana.com/docs/loki/latest/setup/install/helm/",
      "supportTier": "experimental",
      "defaultEnabled": false,
      "privileged": false,
      "artifact": { "type": "helm", "repository": "grafana", "chart": "loki", "version": "7.3.0" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "large" },
      "storage": { "required": true, "recommended": "100Gi" },
      "lifecycle": { "install": true, "upgrade": true, "rollback": false, "uninstall": true }
    },
    {
      "slug": "trivy-operator",
      "name": "Trivy Operator",
      "summary": "Kubernetes-native vulnerability and configuration scanning with Trivy.",
      "category": "security",
      "keywords": ["trivy", "vulnerability", "compliance"],
      "home": "https://github.com/aquasecurity/trivy-operator",
      "documentation": "https://aquasecurity.github.io/trivy-operator/latest/",
      "supportTier": "upstream",
      "defaultEnabled": false,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "aqua", "chart": "trivy-operator", "version": "0.36.0" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "medium" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "cert-manager",
      "name": "cert-manager",
      "summary": "Certificate issuance and renewal for Kubernetes workloads.",
      "category": "security",
      "keywords": ["tls", "certificates", "letsencrypt"],
      "home": "https://cert-manager.io/",
      "documentation": "https://cert-manager.io/docs/installation/helm/",
      "supportTier": "upstream",
      "defaultEnabled": false,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "jetstack", "chart": "cert-manager", "version": "v1.21.1" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "medium" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    },
    {
      "slug": "ingress-nginx",
      "name": "Ingress NGINX",
      "summary": "NGINX-based Kubernetes ingress controller.",
      "category": "networking",
      "keywords": ["ingress", "nginx", "load-balancer"],
      "home": "https://kubernetes.github.io/ingress-nginx/",
      "documentation": "https://kubernetes.github.io/ingress-nginx/deploy/",
      "supportTier": "upstream",
      "defaultEnabled": false,
      "privileged": true,
      "artifact": { "type": "helm", "repository": "ingress-nginx", "chart": "ingress-nginx", "version": "4.15.1" },
      "compatibility": { "kubernetes": ">=1.31.0 <1.36.0" },
      "resources": { "profile": "medium" },
      "storage": { "required": false },
      "lifecycle": { "install": true, "upgrade": true, "rollback": true, "uninstall": true }
    }
  ]
}

