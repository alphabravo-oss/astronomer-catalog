{
  "version": "2.9.0",
  "appVersion": "v2.9.0",
  "artifact": {
    "type": "helm-http",
    "repository": "external-secrets",
    "name": "external-secrets",
    "version": "2.9.0",
    "digest": "sha256:da2d5c126a103b4c1b16a9dc1c168c4332a3687144e88ac070e594f81a0b6578"
  },
  "identities": {
    "chartDigest": "sha256:da2d5c126a103b4c1b16a9dc1c168c4332a3687144e88ac070e594f81a0b6578"
  },
  "available": true,
  "recommended": true,
  "supportTier": "upstream",
  "compatibility": {
    "kubernetes": ">=1.31.0 <1.36.0"
  },
  "configuration": {
    "schema": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "default": 1,
          "title": "Controller replicas",
          "minimum": 0
        },
        "installCRDs": {
          "type": "boolean",
          "default": true,
          "title": "Install CRDs"
        },
        "webhook": {
          "type": "object",
          "properties": {
            "replicaCount": {
              "type": "integer",
              "default": 1,
              "title": "Webhook replicas",
              "minimum": 0
            }
          }
        },
        "certController": {
          "type": "object",
          "properties": {
            "replicaCount": {
              "type": "integer",
              "default": 1,
              "title": "Certificate controller replicas",
              "minimum": 0
            }
          }
        },
        "concurrent": {
          "type": "integer",
          "default": 1,
          "title": "Concurrent reconciles"
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "title": "Create ServiceMonitor"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "title": "Requests",
              "properties": {
                "cpu": {
                  "type": "string",
                  "title": "CPU request",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                },
                "memory": {
                  "type": "string",
                  "title": "Memory request",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "title": "Limits",
              "properties": {
                "cpu": {
                  "type": "string",
                  "title": "CPU limit",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                },
                "memory": {
                  "type": "string",
                  "title": "Memory limit",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                }
              }
            }
          },
          "title": "Controller resources"
        }
      }
    },
    "presets": [
      {
        "id": "upstream",
        "label": "Upstream defaults",
        "description": "Start with the exact chart defaults; configure storage, exposure and secret references for your cluster.",
        "values": {}
      }
    ],
    "defaultPreset": "upstream",
    "namespace": "astronomer-external-secrets"
  }
}
