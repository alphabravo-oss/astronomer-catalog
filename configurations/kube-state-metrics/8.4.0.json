{
  "version": "8.4.0",
  "appVersion": "2.20.0",
  "artifact": {
    "type": "helm-http",
    "repository": "prometheus-community",
    "name": "kube-state-metrics",
    "version": "8.4.0",
    "digest": "sha256:74cc198067993744791e92ee280d8f255a0bbd43c86d765814402c455d478680"
  },
  "identities": {
    "chartDigest": "sha256:74cc198067993744791e92ee280d8f255a0bbd43c86d765814402c455d478680"
  },
  "available": true,
  "recommended": true,
  "supportTier": "experimental",
  "compatibility": {
    "kubernetes": ">=1.31.0 <1.36.0"
  },
  "configuration": {
    "schema": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "autosharding": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "title": "Automatic sharding"
            }
          }
        },
        "metricLabelsAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "title": "Metric label allowlist"
        },
        "metricAnnotationsAllowList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "title": "Metric annotation allowlist"
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "monitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "title": "Create ServiceMonitor"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "title": "Requests",
              "properties": {
                "cpu": {
                  "type": "string",
                  "title": "CPU request",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                },
                "memory": {
                  "type": "string",
                  "title": "Memory request",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "title": "Limits",
              "properties": {
                "cpu": {
                  "type": "string",
                  "title": "CPU limit",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                },
                "memory": {
                  "type": "string",
                  "title": "Memory limit",
                  "pattern": "^([0-9]+(\\.[0-9]+)?([EPTGMK]i?|m)?|)$"
                }
              }
            }
          },
          "title": "Resources"
        }
      }
    },
    "presets": [
      {
        "id": "upstream",
        "label": "Upstream defaults",
        "description": "Start with the exact chart defaults; configure storage, exposure and secret references for your cluster.",
        "values": {}
      }
    ],
    "defaultPreset": "upstream",
    "namespace": "astronomer-monitoring"
  }
}
